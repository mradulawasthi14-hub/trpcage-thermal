; NPT equilibration, 100 ps, protein position-restrained (needs GROMACS >= 2021 for C-rescale)
define               = -DPOSRES
integrator           = md
dt                   = 0.002
nsteps               = 50000
constraints          = h-bonds
constraint-algorithm = lincs
continuation         = yes
cutoff-scheme        = Verlet
nstlist              = 20
coulombtype          = PME
rcoulomb             = 1.0
rvdw                 = 1.0
tcoupl               = V-rescale
tc-grps              = Protein Non-Protein
tau_t                = 0.1 0.1
ref_t                = @TEMP@ @TEMP@
pcoupl               = C-rescale
pcoupltype           = isotropic
tau_p                = 2.0
ref_p                = 1.0
compressibility      = 4.5e-5
gen_vel              = no
nstenergy            = 500
nstlog               = 500
pbc                  = xyz
