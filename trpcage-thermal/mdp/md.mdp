; Production run. @TEMP@ and @NSTEPS@ are filled in by run_all.sh (5,000,000 steps x 2 fs = 10 ns)
integrator           = md
dt                   = 0.002
nsteps               = @NSTEPS@
constraints          = h-bonds
constraint-algorithm = lincs
continuation         = yes
cutoff-scheme        = Verlet
nstlist              = 20
coulombtype          = PME
rcoulomb             = 1.0
rvdw                 = 1.0
tcoupl               = V-rescale
tc-grps              = Protein Non-Protein
tau_t                = 0.1 0.1
ref_t                = @TEMP@ @TEMP@
pcoupl               = C-rescale
pcoupltype           = isotropic
tau_p                = 2.0
ref_p                = 1.0
compressibility      = 4.5e-5
gen_vel              = no
nstxout-compressed   = 5000
compressed-x-grps    = System
nstenergy            = 5000
nstlog               = 5000
pbc                  = xyz
